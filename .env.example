# ---------------------------------------------------------------------------
# NEXA Leads — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public URL of the app. Used for cookie Secure flag and CSRF origin checks.
APP_URL=http://localhost:3000

# Postgres connection string. NEXA Leads is built for a Supabase project:
# Supabase → Settings → Database → Connection string. From most hosts, use
# the "Session pooler" or "Transaction pooler" form (IPv4-compatible) rather
# than "Direct connection" (IPv6-only). Tables are created automatically on
# first run.
DATABASE_URL=

# 32+ character random string used to sign/derive server-side secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Password for the first admin account created by `npm run db:seed`.
# Only used on first seed; change it after the first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Default country + timezone used for phone normalisation and opening hours.
DEFAULT_COUNTRY=DE
DEFAULT_TIMEZONE=Europe/Berlin

# --- Discovery provider -----------------------------------------------------
# Which provider finds businesses: overpass | google-places | fixture
# "fixture" = local demo dataset, clearly badged as demo data in the UI.
DISCOVERY_PROVIDER=fixture

# Overpass (OpenStreetMap, ODbL). Free, no key. Please respect the usage policy
# and keep a descriptive User-Agent with contact details.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=LocalLeadList/0.1 (contact: you@example.com)

# Google Places API (New). Requires a billing-enabled key with the
# "Places API (New)" enabled.
GOOGLE_MAPS_API_KEY=

# --- Geocoding provider -----------------------------------------------------
# nominatim | google | fixture
GEOCODING_PROVIDER=fixture
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org

# --- Web search provider (website discovery) --------------------------------
# brave | google-cse | none
# "none" means the search channel is UNAVAILABLE, which — by design — prevents
# any business from being marked VERIFIED_NO_WEBSITE. It will instead be sent
# to REQUIRES_MANUAL_CHECK. This is intentional: no search = no proof.
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# Optional hard cap on search calls per calendar month, to stay inside a
# provider's free tier (e.g. Brave gives $5/month free credit, ~1,000 calls —
# a margin like 900 keeps you safely under before any real charge could
# apply). Once hit, the search channel reports unavailable for the rest of
# the month and businesses go to "requires manual check", exactly like an
# unconfigured provider — never a false "no website". Leave unset/0 for no cap.
WEB_SEARCH_MONTHLY_LIMIT=

# --- Photos -----------------------------------------------------------------
# google-places | none. Photos are proxied on demand and never stored.
PHOTO_PROVIDER=none

# --- Verification tuning (safe defaults; raising thresholds is safer) -------
# Minimum number of successful discovery channels before VERIFIED_NO_WEBSITE
# may be assigned. Never set below 2.
MIN_CHANNELS_FOR_NO_WEBSITE=2
# Days after which a website verification is considered stale and re-run.
VERIFICATION_TTL_DAYS=30
# Outbound fetch limits for candidate website checks.
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=1500000
